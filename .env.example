# TranceConnect-Prime Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Database Configuration (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=transconnectlinkx
DATABASE_USER=transconnect
DATABASE_PASSWORD=your_mysql_password_here

# Alternative naming support
DB_HOST=localhost
DB_PORT=3306
DB_NAME=transconnectlinkx
DB_USER=transconnect
DB_PASSWORD=your_mysql_password_here

# Security Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET=change-this-to-a-secure-random-secret-key

# Server Port
PORT=5000
FLASK_ENV=development

# Optional External API Keys (Leave blank to use intelligent built-in logistics AI & Leaflet maps)
AI_API_KEY=
GEMINI_API_KEY=
MAPS_API_KEY=
