{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dealer",
      "destination": "/dealer.html"
    },
    {
      "source": "/transporter",
      "destination": "/transporter.html"
    },
    {
      "source": "/transport",
      "destination": "/transporter.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/verify/:match*",
      "destination": "/verify.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/shipments",
      "destination": "/dealer.html"
    },
    {
      "source": "/invoices",
      "destination": "/dealer.html"
    },
    {
      "source": "/delivery-orders",
      "destination": "/dealer.html"
    }
  ]
}
